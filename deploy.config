# TMJ Enhanced Deployment Configuration
# Update these values with your actual Hostinger details

# Hostinger Connection Details
HOSTINGER_HOST="tmjworld.ng"
HOSTINGER_USER="u684694186"
HOSTINGER_PATH="/domains/tmjworld.ng/public_html"
SSH_KEY="$HOME/.ssh/hostinger_deploy"

# Deployment Method Settings
# Options: "branch", "ftp", "both"
DEFAULT_DEPLOY_METHOD="both"
AUTO_DEPLOY_ON_PUSH=true
DEPLOY_BRANCH="main"
BACKUP_BEFORE_DEPLOY=true

# Security Settings
ENABLE_SECURITY_HEADERS=true
ENABLE_CSP=true
ENABLE_HSTS=true

# Environment Settings
PRODUCTION_ENV_FILE=".env.production"
DEVELOPMENT_ENV_FILE=".env"

# Build Settings
BUILD_COMMAND="npm run build"
PRE_DEPLOY_SCRIPT="./deploy-preparation.sh"
POST_DEPLOY_SCRIPT=""

# Notification Settings (optional)
ENABLE_NOTIFICATIONS=false
WEBHOOK_URL=""

# Advanced Settings
ENABLE_ROLLBACK=true
MAX_BACKUP_COUNT=5
DEPLOY_TIMEOUT=300
