# TMJ Deployment Configuration
# Update these values with your actual Hostinger details

HOSTINGER_HOST="your-domain.com"
HOSTINGER_USER="your-hostinger-username"
HOSTINGER_PATH="/home/your-username/public_html"
SSH_KEY="$HOME/.ssh/hostinger_deploy"

# Deployment settings
AUTO_DEPLOY_ON_PUSH=true
DEPLOY_BRANCH="main"
BACKUP_BEFORE_DEPLOY=true
